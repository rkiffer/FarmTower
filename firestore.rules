rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SUBSTITUA o UID abaixo pelo UID da única conta da guild no Firebase Authentication.
    // Uma conta com email/senha conhecida não basta: somente esse UID pode acessar.
    function guildMember() {
      return request.auth != null
        && request.auth.uid == 'FT1jZTxqXrZgjq5zrfnSXUner682';
    }
    match /torres/{towerId} {
      allow read, delete: if guildMember();
      allow create, update: if guildMember()
        && request.resource.data.keys().hasOnly(['id','map','server','nick','capturedAt','createdAt','durationHours'])
        && request.resource.data.id == towerId
        && request.resource.data.map is string && request.resource.data.map.size() > 0 && request.resource.data.map.size() <= 100
        && request.resource.data.server is string && request.resource.data.server.size() > 0 && request.resource.data.server.size() <= 40
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 30
        && request.resource.data.capturedAt is number
        && request.resource.data.createdAt is number
        && request.resource.data.durationHours is number
        && request.resource.data.durationHours > 0
        && request.resource.data.durationHours <= 1000;
    }
    match /config/event {
      allow read: if guildMember();
      allow write: if guildMember()
        && request.resource.data.keys().hasOnly(['maps','servers'])
        && request.resource.data.maps is list
        && request.resource.data.servers is list
        && request.resource.data.maps.size() <= 100
        && request.resource.data.servers.size() <= 100;
    }
  }
}
