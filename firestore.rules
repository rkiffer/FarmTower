rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site comunitário aberto: visitantes autenticados anonimamente podem editar.
    // Para um projeto privado, substitua pela autenticação de membros autorizados.
    match /torres/{towerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'map', 'server', 'nick', 'capturedAt', 'createdAt'])
        && request.resource.data.id == towerId
        && request.resource.data.map is string && request.resource.data.map.size() <= 100
        && request.resource.data.server is string && request.resource.data.server.size() <= 40
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 30
        && request.resource.data.capturedAt is number
        && request.resource.data.createdAt is number;
      allow delete: if request.auth != null;
    }
    match /config/event {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['maps','servers'])
        && request.resource.data.maps is list
        && request.resource.data.servers is list
        && request.resource.data.maps.size() <= 100
        && request.resource.data.servers.size() <= 100;
    }
  }
}
